<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>login 2.0 </title>
<style>
  body {
    font-family: Arial, sans-serif;
    background: #7b3fe4;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }


  .card {
    width: 280px;
    height: 560px;
    background: #5b2a9e;
    border-radius: 24px;
    padding: 50px 26px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    color: white;
    text-align: center;
  }


  .logo {
    width: 70px;
    height: 70px;
    border: 3px solid white;
    border-radius: 50%;
    font-size: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 12px;
  }


  p {
    font-size: 11px;
    opacity: 0.7;
  }


  .buttons {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }


  button {
    padding: 13px;
    border-radius: 20px;
    font-weight: bold;
    cursor: pointer;
  }


  .solid {
    border: none;
    background: white;
    color: #5b2a9e;
  }


  .outline {
    border: 1.5px solid white;
    background: transparent;
    color: white;
  }


  .fingerprint {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    font-size: 26px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 10px auto;
  }
</style>
</head>
<body>


  <div class="card">
    <div>
      <div class="logo">⌄</div>
      <h1>COMPANY NAME</h1>
      <p>SLOGAN HERE</p>
    </div>


    <div class="buttons">
      <button class="solid">Sign in</button>
      <button class="outline">Sign up</button>
    </div>


    <div>
      <p>Now Quick Login Use Touch ID</p>
      <div class="fingerprint">👆</div>
      <p>Use Touch ID</p>
    </div>
  </div>


</body>
</html>
